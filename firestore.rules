rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // ふたりで共有:ルームコード(推測できない長い文字列)を知っている、ログイン済みの人だけ
    match /rooms/{room}/spots/{spot} {
      allow read, write: if request.auth != null && room.size() >= 16;
    }
    // デートのフォルダ(スペース内)
    match /rooms/{room}/dates/{d} {
      allow read, write: if request.auth != null && room.size() >= 16;
    }
    // 数字の招待コード(12桁・7日間有効)。1件ずつ指定して読むことだけ許可(一覧は不可)
    match /invites/{code} {
      allow get: if request.auth != null && resource.data.expiresAt > request.time.toMillis();
      allow create: if request.auth != null && code.matches('[0-9]{12}') && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
    // スペース本体(名前・作成者)と参加者。削除できるのは作成者だけ
    match /rooms/{room} {
      allow read: if request.auth != null && room.size() >= 16;
      allow create: if request.auth != null && room.size() >= 16 && request.resource.data.owner == request.auth.uid;
      allow update, delete: if request.auth != null && room.size() >= 16 && resource.data.owner == request.auth.uid;
    }
    match /rooms/{room}/members/{m} {
      allow read: if request.auth != null && room.size() >= 16;
      allow write: if request.auth != null && room.size() >= 16 && request.auth.uid == m;
    }
    // 自分が入っているスペースの一覧:本人だけ
    match /users/{uid}/rooms/{r} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 自分だけ:本人しか読み書きできない(相手にも見えない)
    match /users/{uid}/spots/{spot} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
