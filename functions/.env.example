# このファイルを「.env」という名前でコピーして、キーを入れてください。
# 空のままでも動きます(その場合はキャプションがメモに入るだけで、店名は手入力)。

# Gemini API のキー(店名を自動で抜き出す。無料枠あり)。https://aistudio.google.com/apikey で発行
GEMINI_API_KEY=

# Google Places API のキー(住所・地図リンクを自動で入れる)。Google Cloud コンソールで発行
GOOGLE_PLACES_KEY=

# (任意)Claude API を使いたい場合は、上の GEMINI_API_KEY を空にして、こちらを入れる
# ANTHROPIC_API_KEY=
